@page "/demo"

<PageTitle>Dashboard</PageTitle>

<div class="container">


    <h1 class="mb-4">Dashboard</h1>

    <div class="row g-3 mb-4">

  
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h1>@totalProducts</h1>
                    <p class="text-muted mb-0">Total Products</p>
                </div>
            </div>
        </div>


        <div class="col-12 col-md-6 col-lg-3">
            <div class="card text-center h-100 border-warning bg-warning-subtle">
                <div class="card-body">
                    <h1 class="text-warning-emphasis">@lowStockProducts</h1>
                    <p class="text-warning-emphasis fw-semibold mb-0">Low Stock Products</p>
                </div>
            </div>
        </div>


        <div class="col-12 col-md-6 col-lg-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h1>@totalCategories</h1>
                    <p class="text-muted mb-0">Total Categories</p>
                </div>
            </div>
        </div>


        <div class="col-12 col-md-6 col-lg-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h1>$@(totalInventoryValue.ToString("N0"))</h1>
                    <p class="text-muted mb-0">Total Inventory Value</p>
                </div>
            </div>
        </div>

    </div>

  
    <h2>Save it</h2>

    <button type="button" class="btn btn-primary">Save it</button>
    <button type="button" class="btn btn-danger">Danger</button>
    <button type="button" class="btn btn-success">Success</button>

    <div class="row mt-3">
        <div class="col-6">Left Content</div>
        <div class="col-6">Right Content</div>
    </div>

    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">Product Name</h5>
            <p class="card-text">99.99</p>
        </div>
    </div>

</div>

@code {
    private int totalProducts = 145;
    private int lowStockProducts = 12;
    private int totalCategories = 8;
    private decimal totalInventoryValue = 48250;
}